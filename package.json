{
	"name": "backto-framework",
	"private": true,
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@wordpress/env": "^10.0.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"test:integration": "wp-env run tests-cli --env-cwd='wp-content/mu-plugins/backto-framework' vendor/bin/phpunit --configuration=phpunit-integration.xml --colors=always",
		"test:e2e": "npx playwright test",
		"test:e2e:video": "npx playwright test --project=chromium --reporter=list",
		"test:e2e:report": "npx playwright show-report tests/e2e/report"
	}
}
