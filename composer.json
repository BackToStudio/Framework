{
  "name": "backto/framework",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Florian Truchot",
      "email": "florian@truchot.co"
    }
  ],
  "require": {
    "php": ">=8.2",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "psr/clock": "^1.0"
  },
  "replace": {
    "backto/admin": "self.version",
    "backto/assets": "self.version",
    "backto/blocks": "self.version",
    "backto/cache": "self.version",
    "backto/cli": "self.version",
    "backto/compose": "self.version",
    "backto/contracts": "self.version",
    "backto/event-dispatcher": "self.version",
    "backto/exception": "self.version",
    "backto/hooks": "self.version",
    "backto/lock": "self.version",
    "backto/observability": "self.version",
    "backto/options-resolver": "self.version",
    "backto/options": "self.version",
    "backto/plugin": "self.version",
    "backto/post-meta": "self.version",
    "backto/post-type": "self.version",
    "backto/rest-api": "self.version",
    "backto/security": "self.version",
    "backto/seo": "self.version",
    "backto/taxonomy": "self.version",
    "backto/queue": "self.version",
    "backto/theme": "self.version"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "bamarni/composer-bin-plugin": "^1.4",
    "psr/container": "1.1.1",
    "symfony/service-contracts": "^2.4",
    "symfony/filesystem": "^5.3",
    "symfony/config": "^5.3",
    "symfony/dependency-injection": "^5.3",
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "^6.9",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-phpunit/wp-phpunit": "^6.7",
    "yoast/phpunit-polyfills": "^3.0",
    "symfony/cache": "^5.3",
    "symfony/event-dispatcher": "^5.3",
    "symfony/options-resolver": "^5.3",
    "symfony/lock": "^5.3"
  },
  "autoload": {
    "psr-4": {
      "BackTo\\Framework\\": "src",
      "BackToVendor\\Symfony\\Contracts\\Service\\": "vendor-scoped/symfony/service-contracts/",
      "BackToVendor\\Symfony\\Component\\Config\\": "vendor-scoped/symfony/config/",
      "BackToVendor\\Symfony\\Component\\Filesystem\\": "vendor-scoped/symfony/filesystem/",
      "BackToVendor\\Symfony\\Component\\DependencyInjection\\": "vendor-scoped/symfony/dependency-injection/",
      "BackToVendor\\Symfony\\Component\\Cache\\": "vendor-scoped/symfony/cache/",
      "BackToVendor\\Symfony\\Contracts\\Cache\\": "vendor-scoped/symfony/cache-contracts/",
      "BackToVendor\\Psr\\Cache\\": "vendor-scoped/psr/cache/",
      "BackToVendor\\Psr\\Log\\": "vendor-scoped/psr/log/",
      "BackToVendor\\Psr\\Container\\": "vendor-scoped/psr/container/",
      "BackToVendor\\Symfony\\Component\\EventDispatcher\\": "vendor-scoped/symfony/event-dispatcher/",
      "BackToVendor\\Symfony\\Contracts\\EventDispatcher\\": "vendor-scoped/symfony/event-dispatcher-contracts/",
      "BackToVendor\\Psr\\EventDispatcher\\": "vendor-scoped/psr/event-dispatcher/",
      "BackToVendor\\Symfony\\Component\\OptionsResolver\\": "vendor-scoped/symfony/options-resolver/",
      "BackToVendor\\Symfony\\Component\\Lock\\": "vendor-scoped/symfony/lock/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "composer prefix-vendor",
      "rm -f ./var/container.php",
      "rm -f ./var/container.meta.php",
      "composer dump-autoload --no-scripts"
    ],
    "tests-report": "./vendor/bin/phpunit --colors=always --coverage-html .phpunit.cache/report",
    "tests-taxonomy": "./vendor/bin/phpunit --testsuite \"taxonomy\" --colors=always",
    "tests-post-type": "./vendor/bin/phpunit --testsuite \"post-type\" --colors=always",
    "tests-blocks": "./vendor/bin/phpunit --testsuite \"blocks\" --colors=always",
    "prefix-vendor": [
      "rm -rf ./vendor-scoped",
      "composer bin php-scoper config minimum-stability dev",
      "composer bin php-scoper config prefer-stable true",
      "composer bin php-scoper require --dev humbug/php-scoper",
      "composer prefix-symfony-dependency-injection",
      "composer prefix-symfony-service-contracts",
      "composer prefix-symfony-config",
      "composer prefix-symfony-filesystem",
      "composer prefix-symfony-cache",
      "composer prefix-symfony-cache-contracts",
      "composer prefix-psr-cache",
      "composer prefix-psr-log",
      "composer prefix-psr-container",
      "composer prefix-symfony-event-dispatcher",
      "composer prefix-symfony-event-dispatcher-contracts",
      "composer prefix-psr-event-dispatcher",
      "composer prefix-symfony-options-resolver",
      "composer prefix-symfony-lock"
    ],
    "prefix-symfony-dependency-injection": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/dependency-injection --config=config/php-scoper/symfony-dependency-injection.inc.php --quiet",
    "prefix-symfony-config": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/config --config=config/php-scoper/symfony-config.inc.php --quiet",
    "prefix-symfony-filesystem": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/filesystem --config=config/php-scoper/symfony-filesystem.inc.php --quiet",
    "prefix-symfony-service-contracts": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/service-contracts --config=config/php-scoper/symfony-service-contracts.inc.php --quiet",
    "prefix-symfony-cache": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/cache --config=config/php-scoper/symfony-cache.inc.php --quiet",
    "prefix-symfony-cache-contracts": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/cache-contracts --config=config/php-scoper/symfony-cache-contracts.inc.php --quiet",
    "prefix-psr-cache": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/psr/cache --config=config/php-scoper/psr-cache.inc.php --quiet",
    "prefix-psr-log": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/psr/log --config=config/php-scoper/psr-log.inc.php --quiet",
    "prefix-psr-container": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/psr/container --config=config/php-scoper/psr-container.inc.php --quiet",
    "prefix-symfony-event-dispatcher": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/event-dispatcher --config=config/php-scoper/symfony-event-dispatcher.inc.php --quiet",
    "prefix-symfony-event-dispatcher-contracts": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/event-dispatcher-contracts --config=config/php-scoper/symfony-event-dispatcher-contracts.inc.php --quiet",
    "prefix-psr-event-dispatcher": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/psr/event-dispatcher --config=config/php-scoper/psr-event-dispatcher.inc.php --quiet",
    "prefix-symfony-options-resolver": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/options-resolver --config=config/php-scoper/symfony-options-resolver.inc.php --quiet",
    "prefix-symfony-lock": "php ./vendor/bin/php-scoper add-prefix --prefix=BackToVendor --output-dir=./vendor-scoped/symfony/lock --config=config/php-scoper/symfony-lock.inc.php --quiet"
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  }
}
